# Copy to .env next to compose.yaml and fill in. Never commit .env — the repository is public.
# Generate secrets with: openssl rand -base64 48

POSTGRES_DB=fitapp
POSTGRES_USER=fitapp
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fitapp
SPRING_DATASOURCE_USERNAME=fitapp
SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=
SERVER_PORT=8080

# Public address of this stand, e.g. https://fitapp.example.ru (links in emails, CORS)
APP_PUBLIC_BASE_URL=

# --- Mail (Yandex) for password reset ---
MAIL_ENABLED=false
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
# Full mailbox address; MAIL_FROM must match it
MAIL_USERNAME=
# App password from Yandex ID (not the mailbox password)
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_EXP_MIN=60

# --- Web Push (VAPID): npx web-push generate-vapid-keys ---
PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:no-reply@example.ru

# --- Trainer subscription (see CLAUDE.md «Подписка тренера») ---
BILLING_ENABLED=false
# test — fake payment page (dev only); robokassa — real payments
BILLING_PROVIDER=test
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=true
ROBOKASSA_HASH=md5
ROBOKASSA_RECEIPT=false

# Seller details shown on /pricing and in the offer (самозанятый)
SELLER_NAME=
SELLER_INN=
SELLER_EMAIL=
SELLER_PHONE=
